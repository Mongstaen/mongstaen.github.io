---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizePath, stripLang, useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang; title?: string; description?: string; altHref?: string }
const { lang, title, description, altHref } = Astro.props;
const t = useTranslations(lang);
const base = stripLang(Astro.url.pathname);
const pageTitle = title ? `${title} · Thomas Mongstad` : 'Thomas Mongstad';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('site.description')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {!altHref && <link rel="alternate" hreflang="nb" href={new URL(localizePath(base, 'nb'), Astro.site)} />}
    {!altHref && <link rel="alternate" hreflang="en" href={new URL(localizePath(base, 'en'), Astro.site)} />}
    <script is:inline defer src="https://stats.vps.papa.party/script.js" data-website-id="d7efd2d5-b770-4970-93c3-6deefc4732c7"></script>
  </head>
  <body>
    <Header lang={lang} altHref={altHref} />
    <main class="wrap"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
