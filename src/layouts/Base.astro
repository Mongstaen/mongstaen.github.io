---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizePath, stripLang, useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang; title?: string; description?: string; altHref?: string; type?: 'website' | 'article'; noindex?: boolean }
const { lang, title, description, altHref, type = 'website', noindex = false } = Astro.props;
const t = useTranslations(lang);
const base = stripLang(Astro.url.pathname);
const pageTitle = title ? `${title} · Thomas Mongstad` : 'Thomas Mongstad';
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Thomas Mongstad" />
    <meta property="og:title" content={title ?? 'Thomas Mongstad'} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'nb' ? 'nb_NO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    {!altHref && !noindex && <link rel="alternate" hreflang="nb" href={new URL(localizePath(base, 'nb'), Astro.site)} />}
    {!altHref && !noindex && <link rel="alternate" hreflang="en" href={new URL(localizePath(base, 'en'), Astro.site)} />}
    <script is:inline defer src="https://stats.vps.papa.party/script.js" data-website-id="d7efd2d5-b770-4970-93c3-6deefc4732c7"></script>
  </head>
  <body>
    <Header lang={lang} altHref={altHref} />
    <main class="wrap"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
