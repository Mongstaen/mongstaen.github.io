---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { localizePath, useTranslations } from '../../../i18n/ui';
import { allTags } from '../../../lib/posts';
export async function getStaticPaths() {
  return (await allTags()).map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}
const { name, posts } = Astro.props;
const t = useTranslations('nb');
---
<Base lang="nb" title={`${t('blog.tagged')} ${name}`}>
  <h1>{t('blog.tagged')} {name}</h1>
  <PostList lang="nb" posts={posts} />
  <p class="back"><a href={localizePath('/blog/', 'nb')}>← {t('blog.back')}</a></p>
</Base>
