---
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { latestPosts, allTags } from '../lib/posts';
import PostList from './PostList.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await latestPosts();
const tags = await allTags();
---
<h1>{t('blog.title')}</h1>
<p class="lede-sm">{t('blog.intro')}</p>
<PostList lang={lang} posts={posts} />
<section class="tags-section" aria-labelledby="tags-h">
  <h2 id="tags-h">{t('blog.tags')}</h2>
  <ul class="tags">
    {tags.map(([slug, { name, posts }]) => (
      <li><a href={localizePath(`/blog/tags/${slug}/`, lang)}>{name}</a> <span>{posts.length}</span></li>
    ))}
  </ul>
  <p><a href="/rss.xml">{t('blog.rss')}</a></p>
</section>
