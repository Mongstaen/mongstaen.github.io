---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localizePath, useTranslations } from '../i18n/ui';
import { dateFormat, type Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const lang = post.data.lang;
const t = useTranslations(lang);
const { Content } = await render(post);
---
<Base lang={lang} title={post.data.title} description={post.data.summary || undefined} altHref={localizePath('/blog/', lang === 'nb' ? 'en' : 'nb')}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{dateFormat(lang).format(post.data.date)}</time>
    </header>
    <div class="prose"><Content /></div>
  </article>
  <p class="back"><a href={localizePath('/blog/', lang)}>← {t('blog.back')}</a></p>
</Base>
