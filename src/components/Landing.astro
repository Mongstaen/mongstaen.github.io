---
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { postUrl, latestPosts } from '../lib/posts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const email = 'thomas@mongstad.dev';

const posts = (await latestPosts()).slice(0, 3);

const fmt = new Intl.DateTimeFormat(lang === 'nb' ? 'nb-NO' : 'en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
});
---
<section class="intro" aria-labelledby="intro-h">
  <h1 id="intro-h">Thomas Mongstad</h1>
  <p class="lede">{t('home.lede')}</p>
  <p>{t('home.intro')}</p>
</section>

<section aria-labelledby="work-h">
  <h2 id="work-h">{t('home.work.h')}</h2>
  <dl class="work">
    <div>
      <dt>{t('home.work.radio.t')}</dt>
      <dd>{t('home.work.radio.d')}</dd>
    </div>
    <div>
      <dt>{t('home.work.web.t')}</dt>
      <dd>{t('home.work.web.d')}</dd>
    </div>
  </dl>
</section>

{posts.length > 0 && (
  <section aria-labelledby="posts-h">
    <h2 id="posts-h">{t('home.posts.h')}</h2>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={postUrl(p)} hreflang={p.data.lang} lang={p.data.lang !== lang ? p.data.lang : undefined}>
            {p.data.title}
          </a>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
        </li>
      ))}
    </ul>
    <p><a href={localizePath('/blog/', lang)}>{t('home.posts.all')}</a></p>
  </section>
)}

<section aria-labelledby="contact-h">
  <h2 id="contact-h">{t('home.contact.h')}</h2>
  <p>{t('home.contact.p')} <a href={`mailto:${email}`}>{email}</a>.</p>
</section>
